# Mot de passe de l'espace admin
ADMIN_PASSWORD=change-moi

# --- Google Drive (recommandé : fichiers privés, choisis via le sélecteur Drive) ---
# console.cloud.google.com : activer "Google Drive API" et "Google Picker API"
# Identifiants > ID client OAuth (type Application Web)
#   URI de redirection autorisé : http://localhost:3100/api/google/callback
# Écran de consentement : scope drive.file uniquement (non sensible)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Identifiants > Clé API (restreinte à Drive API + Picker API) + numéro du projet (GOOGLE_APP_ID)
GOOGLE_API_KEY=
GOOGLE_APP_ID=
# En production derrière un proxy : URL publique de l'app (sinon déduite de la requête)
# APP_URL=https://review.mondomaine.com

# Mode secours : vidéos partagées "Toute personne disposant du lien" (utilise GOOGLE_API_KEY, avec Drive API activée sur la clé)
